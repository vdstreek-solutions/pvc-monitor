VCENTER_HOST=vcenter.example.com
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=your_password_here
VCENTER_PORT=443
VCENTER_VERIFY_SSL=false

# Kubernetes — path to kubeconfig (defaults to ~/.kube/config if unset)
KUBECONFIG_PATH=/path/to/kubeconfig
# Optional: specify a context within the kubeconfig
K8S_CONTEXT=my-cluster-context
# For OIDC clusters: provide the API server URL and a bearer token directly.
# This is the most reliable option when using OIDC — obtain a token with:
#   kubectl get secret <sa-secret> -o jsonpath='{.data.token}' | base64 -d
# or via your OIDC provider (e.g. kubelogin, dex, Pinniped).
K8S_SERVER=https://k8s-api.example.com:6443
K8S_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
# Set to false to skip TLS verification (useful for self-signed certs)
K8S_VERIFY_SSL=true

# ── Dex OIDC authentication ───────────────────────────────────────────────────
# Leave OIDC_ISSUER empty to disable authentication (development mode).
OIDC_ISSUER=https://dex.example.com
OIDC_CLIENT_ID=pvc-monitor
OIDC_CLIENT_SECRET=change-me
# Full callback URL — must match the redirectURI registered in Dex.
OIDC_REDIRECT_URI=https://pvc-monitor.example.com/auth/callback
# Scopes — "groups" lets Dex include group membership in the token.
OIDC_SCOPES=openid email profile groups
# Comma-separated list of Dex groups allowed to log in.
# Leave empty to allow all authenticated users regardless of group.
ALLOWED_GROUPS=infra-team,ops-team
# Secret key for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
# Set to true when running behind HTTPS (sets the Secure flag on the session cookie).
SESSION_SECURE=false
# Set to false to disable auth entirely (useful for local development).
AUTH_ENABLED=true

# ── Email alerting ────────────────────────────────────────────────────────────
# Required to enable alerts:
SMTP_HOST=smtp.example.com
SMTP_FROM=pvc-monitor@example.com
ALERT_EMAIL_TO=team@example.com,ops@example.com

# Optional (defaults shown):
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_SNAPSHOT_AGE_DAYS=7
ALERT_CHECK_INTERVAL_HOURS=24
