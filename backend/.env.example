# Example configuration for local development. Copy to .env and fill in.
# Never commit .env.

# ── vCenter ───────────────────────────────────────────────────────────────────
VCENTER_HOST=vcenter.example.com
# Use a dedicated, least-privileged service account, not an administrator account.
VCENTER_USER=svc-pvc-monitor@vsphere.local
VCENTER_PASSWORD=
VCENTER_PORT=443
# Verify the vCenter TLS certificate (default true). For a private CA, point
# VCENTER_CA_FILE at the CA bundle instead of disabling verification.
VCENTER_VERIFY_SSL=true
# VCENTER_CA_FILE=/path/to/vcenter-ca.pem

# ── Kubernetes ────────────────────────────────────────────────────────────────
# Path to kubeconfig (defaults to ~/.kube/config if unset)
KUBECONFIG_PATH=/path/to/kubeconfig
# Optional: specify a context within the kubeconfig
K8S_CONTEXT=
# Alternative: API server URL and a bearer token for a read-only ServiceAccount.
K8S_SERVER=https://k8s-api.example.com:6443
K8S_TOKEN=
# CA bundle for K8S_SERVER (explicit-token path only).
# K8S_CA_FILE=/path/to/k8s-ca.pem
K8S_VERIFY_SSL=true

# ── OIDC authentication ───────────────────────────────────────────────────────
# Enabled by default. The app refuses to start unless OIDC_ISSUER, OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET and SESSION_SECRET are set. AUTH_ENABLED=false is the only
# way to run without login; use it only on a loopback-bound development setup.
AUTH_ENABLED=true
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=pvc-monitor
OIDC_CLIENT_SECRET=
# Full callback URL — must match the redirect URI registered at the issuer.
OIDC_REDIRECT_URI=https://pvc-monitor.example.com/auth/callback
# Scopes — "groups" lets the issuer include group membership in the token.
OIDC_SCOPES=openid email profile groups
# Comma-separated list of groups allowed to log in.
# Leave empty to allow all authenticated users regardless of group.
ALLOWED_GROUPS=storage-admins
# At least 32 random characters, e.g. the output of: openssl rand -hex 32
SESSION_SECRET=
# Secure cookie flag (default true). Set to false only for local development over
# plain HTTP when your browser drops the Secure session cookie (login loops).
SESSION_SECURE=true
SESSION_MAX_AGE_HOURS=12
# Optional comma-separated list of accepted Host header values.
TRUSTED_HOSTS=
# Exposes vSphere diagnostics; keep false outside troubleshooting.
ENABLE_DEBUG_ENDPOINT=false

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# uvicorn trusts X-Forwarded-* only from these addresses (default 127.0.0.1).
# FORWARDED_ALLOW_IPS=127.0.0.1

# ── Email alerting ────────────────────────────────────────────────────────────
# Required to enable alerts:
SMTP_HOST=smtp.example.com
SMTP_FROM=pvc-monitor@example.com
ALERT_EMAIL_TO=storage-team@example.com

# Optional (defaults shown):
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_SNAPSHOT_AGE_DAYS=7
# Minimum 1.
ALERT_CHECK_INTERVAL_HOURS=24
